    async (req,res,next) =>{
        console.log("creating new folder")
        const errors = validationResult(req);
        if (!errors.isEmpty()) {
        return res.status(400).render("upload-form", {
            errors: errors.array(),
        });

        }
        try {
            const { folderName  } = matchedData(req);
