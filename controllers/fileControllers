        }
    }
]

exports.deleteFolder = async (req,res,next) =>{
    try{
        const folder_id = Number(req.body.folder_id)
        const folder = await prisma.folder.findUnique({where:{id:folder_id}, include: { files: true }})
        if (!folder) return res.redirect("/upload")
        const names = folder.files.map(f=> f.object_name)
        if (names.length) {
            await supabase.storage.from(SUPABASE_BUCKET).remove(names)
        }
        await prisma.file.deleteMany({where: {folder_id:folder_id}});
        await prisma.folder.delete({where: {id:folder_id}});
        res.redirect("/upload")
        

    } catch(err){
        return next(err)
    }
}

