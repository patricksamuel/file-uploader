const { body, validationResult, matchedData } = require("express-validator");
const passport = require("passport");
const { prisma } = require("../lib/sigma");
const multer = require("multer");
const {supabase, SUPABASE_BUCKET} = require("../lib/supabase")
const fs = require("node:fs/promises");


exports.uploadPage = async (req,res) =>{
    console.log("searching for folders")
    const userFolders= await prisma.folder.findMany({
        where: {owner_id: req.user.id},
        include: { files: true },
        orderBy:{id:"asc"}
    })

    res.render("upload-form",{userFoldersNames:userFolders})
}


exports.uploadFile = async (req,res,next) =>{
    const safeName = req.file.originalname.replace(/[^a-zA-Z0-9.\-_]/g, "_");   // anything not alphanumeric/dot/dash/underscore → _


    const objectName = `${req.user.id}/${Date.now()}-${safeName}`;

    console.log("objectName is:", JSON.stringify(objectName));
    console.log("bucket is:", JSON.stringify(SUPABASE_BUCKET));
    console.log("user id is:", req.user.id);

    const {error} = await supabase.storage
        .from(SUPABASE_BUCKET)
        .upload(objectName, req.file.buffer, { contentType: req.file.mimetype})
    if (error) throw error;
    const {data} = supabase.storage
        .from(SUPABASE_BUCKET)
        .getPublicUrl(objectName)

    await prisma.file.create({
        data:{
            name :req.file.originalname,
            object_name: objectName,
            path :data.publicUrl,
            owner_id: Number(req.user.id),
            folder_id: Number(req.body.folder_id)
        }
    })

    res.redirect("/upload")

}

exports.deleteFile = async (req,res,next) =>{
    try {
        const file_id = Number(req.body.file_id)
        console.log(`deleting file id ${file_id}`)
        const file = await prisma.file.findUnique({where: {id:file_id}})
        if (!file) return res.redirect("/upload")

        const {error} = supabase.storage
            .from(SUPABASE_BUCKET)
            .remove([file.object_name])
        if (error) throw error,
        await fs.unlink(file.path)
        await prisma.file.delete({where: {id:file_id}})
        res.redirect("/upload")
    } catch (err){
        next(err);
    }
}

exports.renameFile = [
    body("fileName").trim()
        .isLength({min:1, max:255}).withMessage(`Text Required 255 characters max`),
    async (req,res,next) => {
        try{
            
            const errors = validationResult(req);
            const { fileName  } = matchedData(req);

            if (!errors.isEmpty()) {
            return res.status(400).render("upload-form", {
                errors: errors.array(),
            })};
            const file_id = Number(req.body.file_id)            
            console.log("renaming folder"+ file_id)
            const file = await prisma.file.findUnique({where:{id:file_id}})
            if (!file) return res.redirect("/upload")
            await prisma.file.update({
                where: {id: file_id},
                data: {name: fileName}
            })
            res.redirect("/upload")
        } catch (err){
            return next(err)
        }
}]

exports.downloadFile = async (req,res,next) =>{
    try{
        file = await prisma.file.findUnique({
            where: {id: Number(req.body.file_id)}
        })
        if (!file) return res.redirect("/upload")
        const {data} = supabase.storage
            .from(SUPABASE_BUCKET)
            .getPublicUrl(file.object_name,{
                download: file.name,
            })

        
        res.redirect(data.publicUrl);

    }catch(err){
        next(err)
    }
}

exports.newFolder = [
